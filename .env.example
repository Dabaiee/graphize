# Copy to .env and fill in. `docker compose up` reads this file.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model powers the agents (default: claude-opus-4-8)
FASTGRAPH_MODEL=claude-opus-4-8

# Optional: Neo4j password (default: fastgraph)
NEO4J_PASSWORD=fastgraph
