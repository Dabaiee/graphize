# Copy to .env and fill in. `docker compose up` reads this file.
# NOTE: you can also configure the model provider/keys in the app's ⚙ Settings UI
# (persisted in the data volume) instead of setting them here.

# --- Model provider: anthropic | openai | ollama ---
FASTGRAPH_PROVIDER=anthropic

# Anthropic (Claude) — best quality
ANTHROPIC_API_KEY=sk-ant-...
FASTGRAPH_MODEL=claude-opus-4-8

# OpenAI (GPT) — optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # optional (Azure/proxy)

# Ollama (local, free, offline) — optional
# From the dockerized backend, reach a host Ollama via host.docker.internal:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Infra ---
NEO4J_PASSWORD=fastgraph
